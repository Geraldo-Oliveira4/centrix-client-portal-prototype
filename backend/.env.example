# Local Postgres (docker-compose)
DATABASE_URL=postgresql+psycopg2://postgres:test@localhost:5432/centrix_portal

# Auto-login demo user. Must match the portal_user seeded by seed_prototype.py.
DEMO_PORTAL_SUB=demo-portal-user-sub
DEMO_PORTAL_EMAIL=demo@cliente.local

# Email sender (mocked — value only needs to be non-empty so dispatch handlers
# don't short-circuit with "Email sender not configured").
MS_GRAPH_MAILBOX_USER=cotacao@local

# Frontend origin for links in emails and CORS
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Where mocked S3 files are stored, and the base URL for presigned links
LOCAL_STORAGE_DIR=storage
LOCAL_S3_BASE_URL=http://localhost:8000

# Deliberately UNSET so sqs_service.publish_extraction_task no-ops:
# SQS_EXTRACTION_QUEUE_URL=
