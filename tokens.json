{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Freitas Centrix",
  "version": "1.0.0",
  "color": {
    "brand": {
      "navy":   { "$value": "#1A1C31", "$type": "color", "$description": "Navy Profundo. Superfície escura estrutural." },
      "indigo": { "$value": "#2C2E65", "$type": "color", "$description": "Índigo. Cor da marca: logo, títulos, botões secundários." },
      "orange": { "$value": "#F59C27", "$type": "color", "$description": "Laranja. Destaque, CTA, símbolo. Teto de 10% da composição." },
      "white":  { "$value": "#FFFFFF", "$type": "color" },
      "mist":   { "$value": "#F4F5FA", "$type": "color", "$description": "Cinza Névoa. Superfície clara estrutural." }
    },
    "indigo": {
      "950": { "$value": "#1A1C31", "$type": "color" },
      "900": { "$value": "#22244D", "$type": "color" },
      "800": { "$value": "#2C2E65", "$type": "color" },
      "700": { "$value": "#464A78", "$type": "color" },
      "600": { "$value": "#686A9A", "$type": "color" },
      "500": { "$value": "#898CBB", "$type": "color" },
      "400": { "$value": "#A4A6D5", "$type": "color" },
      "300": { "$value": "#C1C3F3", "$type": "color" },
      "200": { "$value": "#D7D9FB", "$type": "color" },
      "100": { "$value": "#EAECFC", "$type": "color" },
      "50":  { "$value": "#F4F5FA", "$type": "color" }
    },
    "orange": {
      "800": { "$value": "#7A4407", "$type": "color", "$description": "Texto laranja acessível sobre branco (AA)." },
      "700": { "$value": "#A85E0A", "$type": "color" },
      "600": { "$value": "#DD8803", "$type": "color" },
      "500": { "$value": "#F59C27", "$type": "color" },
      "400": { "$value": "#FEB93C", "$type": "color" },
      "300": { "$value": "#FDC959", "$type": "color" },
      "200": { "$value": "#FDDB96", "$type": "color" },
      "100": { "$value": "#FDE8B8", "$type": "color" },
      "50":  { "$value": "#FDF1D9", "$type": "color" }
    },
    "semantic": {
      "success":    { "$value": "#1E9E63", "$type": "color" },
      "success-bg": { "$value": "#E3F6EC", "$type": "color" },
      "warning":    { "$value": "#C98A00", "$type": "color" },
      "warning-bg": { "$value": "#FFF4D6", "$type": "color" },
      "danger":     { "$value": "#D64545", "$type": "color" },
      "danger-bg":  { "$value": "#FBE7E7", "$type": "color" },
      "info":       { "$value": "#4C6FD1", "$type": "color" },
      "info-bg":    { "$value": "#E6ECFB", "$type": "color" }
    },
    "role": {
      "light": {
        "bg":            { "$value": "{color.brand.mist}", "$type": "color" },
        "surface":       { "$value": "{color.brand.white}", "$type": "color" },
        "surface-2":     { "$value": "{color.indigo.100}", "$type": "color" },
        "ink":           { "$value": "{color.brand.navy}", "$type": "color" },
        "ink-2":         { "$value": "{color.indigo.700}", "$type": "color" },
        "ink-3":         { "$value": "{color.indigo.600}", "$type": "color" },
        "border":        { "$value": "#DDE0EE", "$type": "color" },
        "border-strong": { "$value": "{color.indigo.300}", "$type": "color" },
        "link":          { "$value": "{color.brand.indigo}", "$type": "color" },
        "focus":         { "$value": "{color.brand.orange}", "$type": "color" }
      },
      "dark": {
        "bg":       { "$value": "{color.brand.navy}", "$type": "color" },
        "surface":  { "$value": "#23253F", "$type": "color" },
        "ink":      { "$value": "{color.brand.white}", "$type": "color" },
        "ink-2":    { "$value": "{color.indigo.300}", "$type": "color" },
        "ink-3":    { "$value": "{color.indigo.400}", "$type": "color" },
        "border":   { "$value": "rgba(255,255,255,0.12)", "$type": "color" },
        "line":     { "$value": "rgba(255,255,255,0.28)", "$type": "color" }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "New Black, Source Sans Pro, system-ui, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "Source Sans Pro, system-ui, -apple-system, Segoe UI, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "display": { "$value": "clamp(2.75rem, 5vw, 4.5rem)", "$type": "dimension" },
      "h1":      { "$value": "clamp(2.25rem, 4vw, 3.5rem)", "$type": "dimension" },
      "h2":      { "$value": "clamp(1.75rem, 3vw, 2.5rem)", "$type": "dimension" },
      "h3":      { "$value": "1.5rem", "$type": "dimension" },
      "h4":      { "$value": "1.25rem", "$type": "dimension" },
      "lead":    { "$value": "1.25rem", "$type": "dimension" },
      "body-lg": { "$value": "1.125rem", "$type": "dimension" },
      "body":    { "$value": "1rem", "$type": "dimension" },
      "small":   { "$value": "0.875rem", "$type": "dimension" },
      "caption": { "$value": "0.75rem", "$type": "dimension" }
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.05, "snug": 1.2, "normal": 1.5, "relaxed": 1.65 },
    "letterSpacing": { "tight": "-0.02em", "label": "0.08em" }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
    "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px"
  },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "2xl": "40px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(26,28,49,.06), 0 1px 3px rgba(26,28,49,.08)",
    "md": "0 4px 12px rgba(26,28,49,.10), 0 2px 4px rgba(26,28,49,.06)",
    "lg": "0 16px 40px rgba(26,28,49,.16), 0 4px 12px rgba(26,28,49,.08)",
    "glow-orange": "0 8px 24px rgba(245,156,39,.35)"
  },
  "motion": {
    "duration": { "fast": "150ms", "base": "250ms", "slow": "400ms" },
    "easing": { "out": "cubic-bezier(0.2, 0, 0, 1)", "in": "cubic-bezier(0.4, 0, 1, 1)", "inout": "cubic-bezier(0.4, 0, 0.2, 1)" }
  },
  "layout": {
    "container": "1280px", "containerText": "72ch", "columns": 12, "gutter": "24px", "gutterMobile": "16px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1440px" },
    "zIndex": { "base": 0, "raised": 10, "dropdown": 20, "sticky": 40, "overlay": 100, "modal": 1000 }
  },
  "component": {
    "button": {
      "height": { "sm": "36px", "md": "44px", "lg": "56px" },
      "paddingX": { "sm": "14px", "md": "20px", "lg": "28px" },
      "radius": "{radius.md}",
      "primary":   { "bg": "{color.brand.orange}", "ink": "{color.brand.navy}", "hoverBg": "{color.orange.400}" },
      "secondary": { "bg": "{color.brand.indigo}", "ink": "{color.brand.white}", "hoverBg": "{color.indigo.900}" },
      "outline":   { "border": "{color.brand.indigo}", "ink": "{color.brand.indigo}", "hoverBg": "{color.indigo.100}" }
    },
    "input": { "height": "44px", "radius": "{radius.md}", "border": "{color.role.light.border-strong}", "focusRing": "0 0 0 3px rgba(245,156,39,.45)" },
    "card": { "radius": "{radius.lg}", "padding": "{space.6}", "border": "{color.role.light.border}" }
  }
}
